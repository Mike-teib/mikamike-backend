+    data = r.json()
+    assert data["exercice_id"] != "exo-default"
+    assert data["notion_id"] != "notion-default"
+
+def test_absence_secret_par_defaut():
+    from app.core.security_config import get_pseudo_secret
+    secret = get_pseudo_secret()
