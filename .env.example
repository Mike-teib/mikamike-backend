# .env.example — NOMS des variables uniquement. Ne JAMAIS committer de vraie valeur.
# Copier en .env (ignoré par git) et renseigner des valeurs fortes et distinctes.

# Obligatoires (fail-closed : l'app refuse de démarrer sinon ; >= 16 caractères,
# valeurs génériques refusées ; les deux secrets doivent être DIFFÉRENTS).
MIKA_PSEUDO_SECRET=
MIKA_JWT_SECRET=

# Bases (défauts SQLite locaux)
MIKA_DB_URL=sqlite:///./mikamike_backend.db
BILLING_DB_URL=sqlite:///./billing.db

# Config non sensible
MIKA_TOKEN_TTL_H=168
MIKA_APP_URL=http://localhost:3012
CORS_ORIGINS=

# Stripe (optionnel ; sans ces variables, /paiement renvoie une erreur explicite)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Session cloud 2 (AUTH_CONTRACT.md, CLOUD_DB_MIGRATION_PLAN.md) ---
# Environnement : "production" interdit MIKA_AUTH_MODE=off et tout contenu fictif.
MIKA_ENV=
# Authentification des routes élève/parent/RGPD : enforce (défaut si vide) | off (transition front, jamais en prod)
MIKA_AUTH_MODE=enforce
# Durée des jetons de séance élève (minutes, 1..720)
MIKA_ELEVE_TOKEN_TTL_MIN=120
# Schéma au démarrage : check (défaut, refus si base pas à jour) | migrate | none (tests)
MIKA_DB_INIT=check
# Taille max d'un corps de requête (octets, défaut 4 Mio)
MIKA_MAX_BODY_BYTES=4194304

# --- Session cloud 3 : limitation des tentatives (R7, CLOUD_SECURITY_REPORT.md) ---
# on (défaut) | off (tests uniquement ; interdit si MIKA_ENV=production)
MIKA_RATE_LIMIT=on
# Nombre de reverse proxys de confiance devant l'app (0 = X-Forwarded-For ignoré)
MIKA_PROXY_HOPS=0
# 1 = limite aussi par e-mail seul (à n'activer qu'avec CAPTCHA/2FA : sinon verrouillage d'autrui)
MIKA_RL_EMAIL_GLOBAL=0

# --- Décisions D5 / D8 (session 3) ---
# Correction symbolique du catalogue historique : on (défaut, équivalences démontrées seulement) | off
MIKA_CORRECTION_SYMBOLIQUE=on
# Durée de validité d'une invitation de lien parent ↔ élève (minutes, 10..10080 ; défaut 48 h)
MIKA_INVITATION_TTL_MIN=2880

# --- Session 4 : vérification d'adresse (R19) ---
# requise (défaut) | off (hors production uniquement)
MIKA_EMAIL_VERIFICATION=requise
# Durée de validité d'un jeton de vérification (minutes, 10..10080 ; défaut 24 h)
MIKA_EMAIL_VERIF_TTL_MIN=1440
# Transport de courriel : faux (défaut hors prod, mémoire) | journal | <fournisseur enregistré>.
# Production : un fournisseur RÉEL doit être enregistré (aucun n'est intégré aujourd'hui).
MIKA_EMAIL_TRANSPORT=

# --- Rétention RGPD (session 4, lot 20) — durées en jours (1..3650), proposition à valider (DPO).
# Purge : `python -m tools.purge_retention` (simulation) puis `--appliquer` (opérateur).
MIKA_RETENTION_SESSIONS_JOURS=30
MIKA_RETENTION_TUTORAT_REQUETES_JOURS=30
MIKA_RETENTION_TUTORAT_SESSIONS_JOURS=180
MIKA_RETENTION_VERIFICATIONS_EMAIL_JOURS=7
