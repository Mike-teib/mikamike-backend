# .env.example — NOMS des variables uniquement. Ne JAMAIS committer de vraie valeur.
# Copier en .env (ignoré par git) et renseigner des valeurs fortes et distinctes.

# Obligatoires (fail-closed : l'app refuse de démarrer sinon ; >= 16 caractères,
# valeurs génériques refusées ; les deux secrets doivent être DIFFÉRENTS).
MIKA_PSEUDO_SECRET=
MIKA_JWT_SECRET=

# Bases (défauts SQLite locaux)
MIKA_DB_URL=sqlite:///./mikamike_backend.db
BILLING_DB_URL=sqlite:///./billing.db

# Config non sensible
MIKA_TOKEN_TTL_H=168
MIKA_APP_URL=http://localhost:3012
CORS_ORIGINS=

# Stripe (optionnel ; sans ces variables, /paiement renvoie une erreur explicite)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Session cloud 2 (AUTH_CONTRACT.md, CLOUD_DB_MIGRATION_PLAN.md) ---
# Environnement : "production" interdit MIKA_AUTH_MODE=off et tout contenu fictif.
MIKA_ENV=
# Authentification des routes élève/parent/RGPD : enforce (défaut si vide) | off (transition front, jamais en prod)
MIKA_AUTH_MODE=enforce
# Durée des jetons de séance élève (minutes, 1..720)
MIKA_ELEVE_TOKEN_TTL_MIN=120
# Schéma au démarrage : check (défaut, refus si base pas à jour) | migrate | none (tests)
MIKA_DB_INIT=check
# Taille max d'un corps de requête (octets, défaut 4 Mio)
MIKA_MAX_BODY_BYTES=4194304
