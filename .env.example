# .env.example — NOMS des variables uniquement. Ne JAMAIS committer de vraie valeur.
# Copier en .env (ignoré par git) et renseigner des valeurs fortes et distinctes.

# Obligatoires (fail-closed : l'app refuse de démarrer sinon ; >= 16 caractères,
# valeurs génériques refusées ; les deux secrets doivent être DIFFÉRENTS).
MIKA_PSEUDO_SECRET=
MIKA_JWT_SECRET=

# Bases (défauts SQLite locaux)
MIKA_DB_URL=sqlite:///./mikamike_backend.db
BILLING_DB_URL=sqlite:///./billing.db

# Config non sensible
MIKA_TOKEN_TTL_H=168
MIKA_APP_URL=http://localhost:3012
CORS_ORIGINS=

# Stripe (optionnel ; sans ces variables, /paiement renvoie une erreur explicite)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
