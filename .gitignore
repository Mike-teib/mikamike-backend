# === MikaMike backend — .gitignore ===

# Secrets / env (exclusions CIBLÉES — pas de motif trop large type *_secret*)
.env
.env.*
!.env.example
mika.env
secrets/
*.secret
*.key
*.pem
*.p12
*.pfx
credentials.json
credentials-*.json
service-account*.json

# Bases de données locales / données réelles
*.db
*.sqlite
*.sqlite3
*.db-journal
data/
!pedagogy/data/
/data/

# Python
__pycache__/
*.pyc
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# venvs
.venv/
venv/
env/
ENV/

# Tests / couverture
.pytest_cache/
.coverage
.coverage.*
coverage/
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# Node (si outillage front ajouté)
node_modules/
.next/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs / temporaires
*.log
tmp/
reports/
